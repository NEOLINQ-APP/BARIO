# Copy this file to .env.local and fill in real values for local development.
# In Vercel, set these under Project Settings -> Environment Variables.

# Postgres (Neon). Either name works — the app checks DATABASE_URL first.
DATABASE_URL=
POSTGRES_URL=

# Session cookie signing secret — generate with `openssl rand -base64 32`
SESSION_SECRET=

# OpenAI — powers the AI website builder
OPENAI_API_KEY=

# Unsplash — real stock photos for the AI website builder (Zeus). Free tier,
# get a key at unsplash.com/developers. Falls back to placeholder images if unset.
UNSPLASH_ACCESS_KEY=

# Stripe — subscription billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=

# Resend — transactional email (password reset, email verification)
RESEND_API_KEY=
EMAIL_FROM="Bario <onboarding@resend.dev>"

# Vercel API — used to add/verify/remove custom domains for published sites
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Cloudflare API — used to provision DNS zones/records for connected custom domains
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Sentry — error tracking (optional; disabled if unset)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# RunPod — self-hosted Studio (video/voiceover generation), see studio-worker/README.md
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Cron route auth (used by vercel.json's scheduled crons)
CRON_SECRET=

# Social Dispatcher (app/(account)/dashboard/social) — customer-facing
# multi-platform post/lead-ads feature, lib/social/*. Each pair identifies
# Bario's own developer app on that platform; per-customer tokens are
# obtained dynamically via OAuth and stored in the social_connections table.
# Meta (Facebook + Instagram) — developers.facebook.com, needs App Review
# (Advanced Access) for instagram_content_publish + leads_retrieval before
# this works for anyone other than the app's own test users.
META_APP_ID=
META_APP_SECRET=
# Set in the Meta App Dashboard's webhook config for app/api/social/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=
# TikTok for Business developer app — developers.tiktok.com. Until TikTok
# audits the app and grants the "Direct Post" scope, every published video
# lands in the creator's TikTok inbox as a draft, not live (see lib/social/tiktok.ts).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# LinkedIn developer app — needs the "Community Management API" product
# added before w_organization_social/rw_organization_admin scopes are grantable.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
